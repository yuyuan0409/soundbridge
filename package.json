{
  "name": "soundbridge",
  "version": "1.0.0",
  "private": true,
  "description": "声桥 — 双人实时共享设备声音，P2P 优先 / 自动服务器中继",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "cert": "node scripts/make-cert.mjs",
    "test": "node --test test/server.test.js",
    "test:e2e": "node test/e2e.mjs",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy",
    "worker:deploy:temporary": "npx wrangler deploy --temporary",
    "test:worker": "node test/worker-protocol.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0",
    "selfsigned": "^2.4.1"
  }
}
