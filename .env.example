# ---- 基础 ----
PORT=8787
# 存在证书时额外启动的 HTTPS 端口
HTTPS_PORT=8443
HOST=0.0.0.0
# 对外的长期公网地址（部署到 Render/VPS 后填写，用于邀请链接）
PUBLIC_URL=

# ---- HTTPS ----
# 方式一：把证书放到 certs/cert.pem 和 certs/key.pem，服务器会在 HTTP 之外额外启动 HTTPS_PORT
# 方式二：用环境变量指定证书
# TLS_CERT=./certs/cert.pem
# TLS_KEY=./certs/key.pem
# 云端 / Caddy 反向代理已经终止 TLS 时设为 0
# HTTPS=0

# ---- 公网访问 / ICE / TURN ----
# 自动中继始终启用，不需要额外配置。
# 逗号分隔的 STUN 地址
STUN_URLS=stun:stun.l.google.com:19302

# 跨公网会自动使用服务器中继；TURN 可选，用于让更多连接走 P2P。二选一：
# 1) 静态用户名密码
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# 2) coturn REST API 临时凭据（推荐）
TURN_SECRET=
TURN_TTL=3600
